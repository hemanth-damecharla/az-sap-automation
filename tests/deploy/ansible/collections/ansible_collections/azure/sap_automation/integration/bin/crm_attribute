#!/usr/bin/env python3
"""Test double for crm_attribute: node attributes in a JSON file beside the CIB."""
import json, os, sys
path = os.environ["FAKE_CIB"] + ".attrs.json"
attrs = json.load(open(path)) if os.path.exists(path) else {}
args = sys.argv[1:]
key = "%s/%s" % (args[args.index("--node") + 1], args[args.index("--name") + 1])
if "--query" in args:
    if key not in attrs:
        sys.stderr.write("No such device or address\n"); sys.exit(105)
    print(attrs[key]); sys.exit(0)
if "--update" in args:
    attrs[key] = args[args.index("--update") + 1]
elif "--delete" in args:
    attrs.pop(key, None)
json.dump(attrs, open(path, "w"), sort_keys=True)
